/******************************************************************************************
 *
 * File:        qlik_load_script.qvs
 * Project:     Cash Pooling Proof of Concept
 * Platform:    Qlik Sense Cloud
 *
 * Author:      Alexandre de Andrade
 * Purpose:     Initial ETL load script for the Cash Pooling PoC.
 *
 * Description:
 * This script implements the first stage of the ETL process:
 * - Loading crude (raw) CSV data
 * - Preserving source structure and granularity
 * - Establishing a governed foundation for further transformations
 *
 * Design Principles:
 * - Separation of concerns
 * - Traceability and reprocessability
 * - Clear distinction between data layers
 *
 * IMPORTANT:
 * At this stage, NO business rules, aggregations or derived metrics
 * are applied. All transformations will be introduced incrementally
 * and documented.
 *
 ******************************************************************************************/

/*==============================================================================
  0. ENVIRONMENT & SCRIPT SETTINGS
==============================================================================*/

/*
Decision:
Explicitly define script environment settings to avoid implicit defaults
that may vary across environments or developers.

Rationale:
Improves predictability, readability and portability of the script.
*/

SET ThousandSep=',';
SET DecimalSep='.';
SET MoneyThousandSep=',';
SET MoneyDecimalSep='.';
SET MoneyFormat='$#,##0.00;-$#,##0.00';
SET TimeFormat='hh:mm:ss';
SET DateFormat='YYYY-MM-DD';
SET TimestampFormat='YYYY-MM-DD hh:mm:ss[.fff]';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;


/*==============================================================================
  1. DATA SOURCE PARAMETERS
==============================================================================*/

/*
Decision:
Centralize file paths and parameters at the beginning of the script.

Rationale:
- Simplifies maintenance
- Enables quick redirection to other environments
- Is a standard practice in governed ETL pipelines
*/

LET vRawDataPath = 'lib://data/raw/';


/*==============================================================================
  2. RAW (CRUDE) DATA LOAD
==============================================================================*/

/*
This section loads data exactly as provided by the source CSV files.

Decision:
No transformations, no joins, no calculations at this stage.

Rationale:
- Preserves data lineage
- Enables full reload and reprocessing
- Aligns with data lake / lakehouse concepts
*/


/*------------------------------------------------------------------------------
  2.1 Company Master Data
------------------------------------------------------------------------------*/

Companies_Raw:
LOAD
    company_code,
    company_name,
    parent_company,
    country,
    local_currency
FROM [$(vRawDataPath)companies.csv]
(txt, utf8, embedded labels, delimiter=',', msq);


/*
Decision:
Keep company hierarchy attributes in the raw layer.

Rationale:
Hierarchy logic will be applied later, but source attributes must
remain untouched for transparency and auditability.
*/


/*------------------------------------------------------------------------------
  2.2 Cost Center Master Data
------------------------------------------------------------------------------*/

CostCenters_Raw:
LOAD
    cost_center,
    cost_center_name,
    company_code,
    country
FROM [$(vRawDataPath)cost_centers.csv]
(txt, utf8, embedded labels, delimiter=',', msq);


/*------------------------------------------------------------------------------
  2.3 Country Reference Data
------------------------------------------------------------------------------*/

Countries_Raw:
LOAD
    country,
    region,
    reporting_currency
FROM [$(vRawDataPath)countries.csv]
(txt, utf8, embedded labels, delimiter=',', msq);


/*------------------------------------------------------------------------------
  2.4 Currency Reference Data
------------------------------------------------------------------------------*/

Currencies_Raw:
LOAD
    currency,
    currency_name,
    exchange_rate_to_group
FROM [$(vRawDataPath)currencies.csv]
(txt, utf8, embedded labels, delimiter=',', msq);


/*------------------------------------------------------------------------------
  2.5 Treasury Cash Position (Fact – Crude)
------------------------------------------------------------------------------*/

CashPosition_Raw:
LOAD
    company_code,
    company_name,
    country,
    cost_center,
    fiscal_year,
    fiscal_month,
    currency,
    opening_balance,
    cash_in,
    cash_out,
    closing_balance,
    pooling_scenario
FROM [$(vRawDataPath)treasury_cash_position.csv]
(txt, utf8, embedded labels, delimiter=',', msq);


/*
Decision:
Load the cash position table as a single, non-aggregated fact dataset.

Rationale:
- Monthly grain is preserved
- Pre/Post pooling scenarios coexist in the same structure
- Enables flexible analytical slicing later
*/


/*==============================================================================
  3. HOUSEKEEPING & SCRIPT CONTROL
==============================================================================*/

/*
Decision:
Explicitly separate raw data load from transformation logic.

Rationale:
This makes the script easier to read, review and evolve incrementally.
Subsequent sections will:
- Rename tables
- Apply transformations
- Build the analytical model
*/
/******************************************************************************************
 *
 * GOVERNED DIMENSIONS
 *
 * Scope:
 * - Create governed dimension tables (Dim_*)
 * - Preserve raw data integrity
 * - Prepare the analytical model foundation
 *
 ******************************************************************************************/

/*==============================================================================
  4. GOVERNED DIMENSIONS
==============================================================================*/

/*
Decision:
Introduce governed dimensions as separate logical entities (Dim_*),
derived from raw datasets.

Rationale:
- Clear separation between source data and analytical structures
- Improves readability and maintainability
- Aligns with enterprise BI modeling practices
*/


/*------------------------------------------------------------------------------
  4.1 Company Dimension
------------------------------------------------------------------------------*/

/*
Decision:
Create a single Company dimension containing both entity attributes
and hierarchical information (parent company).

Rationale:
- Enables standalone and consolidated analysis
- Avoids pre-aggregation
- Reflects real-world multinational corporate structures
*/

Dim_Company:
LOAD DISTINCT
    company_code,
    company_name,
    parent_company,
    country            AS company_country,
    local_currency
RESIDENT Companies_Raw;


/*
Decision:
Keep hierarchy fields (parent_company) directly in the dimension.

Rationale:
- Simplifies consolidation logic later
- Avoids separate hierarchy tables at this PoC stage
*/


/*------------------------------------------------------------------------------
  4.2 Cost Center Dimension
------------------------------------------------------------------------------*/

/*
Decision:
Model Cost Centers as a governed dimension linked to Company.

Rationale:
- Cost centers are stable master data
- They define analytical slicing for treasury monitoring
*/

Dim_CostCenter:
LOAD DISTINCT
    cost_center,
    cost_center_name,
    company_code,
    country            AS cost_center_country
RESIDENT CostCenters_Raw;


/*------------------------------------------------------------------------------
  4.3 Country Dimension
------------------------------------------------------------------------------*/

/*
Decision:
Create an explicit Country dimension, even if attributes are minimal.

Rationale:
- Enables geographical analysis
- Supports future regional aggregation
- Improves semantic clarity in the data model
*/

Dim_Country:
LOAD DISTINCT
    country,
    region,
    reporting_currency
RESIDENT Countries_Raw;


/*------------------------------------------------------------------------------
  4.4 Currency Dimension
------------------------------------------------------------------------------*/

/*
Decision:
Model Currency as a dimension rather than embedding attributes
directly in the fact table.

Rationale:
- Centralizes exchange rate governance
- Facilitates controlled currency conversion
- Avoids duplication of reference data
*/

Dim_Currency:
LOAD DISTINCT
    currency,
    currency_name,
    exchange_rate_to_group
RESIDENT Currencies_Raw;


/*==============================================================================
  5. RAW DATA CLEANUP (OPTIONAL)
==============================================================================*/

/*
Decision:
At this stage, raw tables are intentionally kept in memory.

Rationale:
- Allows validation and comparison between raw and governed layers
- Useful during PoC development and debugging

Raw tables may be dropped in a later optimization step.
*/
/******************************************************************************************
 *
 * FISCAL CALENDAR DIMENSION
 *
 * Scope:
 * - Create a governed fiscal calendar dimension (Dim_Calendar)
 * - Support time-based treasury analysis
 * - Enable MoM and YoY comparisons
 *
 ******************************************************************************************/

/*==============================================================================
  6. FISCAL CALENDAR DIMENSION
==============================================================================*/

/*
Decision:
Create an explicit fiscal calendar dimension derived from fact data.

Rationale:
- Avoids hardcoding date ranges
- Ensures calendar aligns exactly with available data
- Is a best practice in enterprise analytics
*/


/*------------------------------------------------------------------------------
  6.1 Determine Calendar Range
------------------------------------------------------------------------------*/

/*
Decision:
Derive the calendar range from the cash position fact raw data.

Rationale:
- Guarantees full coverage of the dataset
- Prevents unused calendar periods
*/

Temp_CalendarRange:
LOAD
    Min(MakeDate(fiscal_year, fiscal_month, 1)) AS min_date,
    Max(MakeDate(fiscal_year, fiscal_month, 1)) AS max_date
RESIDENT CashPosition_Raw;


LET vMinDate = Num(Peek('min_date', 0, 'Temp_CalendarRange'));
LET vMaxDate = Num(Peek('max_date', 0, 'Temp_CalendarRange'));

DROP TABLE Temp_CalendarRange;


/*------------------------------------------------------------------------------
  6.2 Generate Calendar Dates
------------------------------------------------------------------------------*/

/*
Decision:
Generate calendar at the monthly grain.

Rationale:
- Aligns with treasury reporting cycles
- Matches the grain of the fact table
- Avoids unnecessary daily-level data
*/

Temp_Calendar:
LOAD
    Date($(vMinDate) + IterNo() - 1) AS calendar_date
AUTOGENERATE 1
WHILE $(vMinDate) + IterNo() - 1 <= $(vMaxDate);


/*------------------------------------------------------------------------------
  6.3 Build Governed Calendar Dimension
------------------------------------------------------------------------------*/

/*
Decision:
Expose both numeric and descriptive time attributes.

Rationale:
- Supports flexible filtering and grouping
- Enables executive-friendly dashboards
*/

Dim_Calendar:
LOAD
    calendar_date,
    Year(calendar_date)                          AS fiscal_year,
    Month(calendar_date)                         AS fiscal_month_name,
    Month(calendar_date)                         AS fiscal_month,
    Num(Month(calendar_date))                    AS fiscal_month_number,
    Date(MonthStart(calendar_date), 'YYYY-MM')   AS fiscal_year_month,
    'FY' & Year(calendar_date)                   AS fiscal_year_label
RESIDENT Temp_Calendar;


/*------------------------------------------------------------------------------
  6.4 Cleanup Temporary Tables
------------------------------------------------------------------------------*/

DROP TABLE Temp_Calendar;


/*
Decision:
Keep calendar attributes simple and transparent.

Rationale:
- PoC focus is analytics and governance, not calendar complexity
- Fiscal year = calendar year by design (documented assumption)
*/

/******************************************************************************************
 *
 * GOVERNED FACT TABLE
 *
 * Scope:
 * - Create Fact_Cash_Position
 * - Preserve monthly grain
 * - Prepare for currency conversion and consolidation
 *
 ******************************************************************************************/

/*==============================================================================
  7. GOVERNED FACT – CASH POSITION
==============================================================================*/

/*
Decision:
Create a single governed fact table representing cash position
for both Pre and Post Cash Pooling scenarios.

Rationale:
- Enables direct comparison between scenarios
- Avoids duplicated fact structures
- Simplifies analytical consumption
*/


/*------------------------------------------------------------------------------
  7.1 Fact Table Creation
------------------------------------------------------------------------------*/

Fact_Cash_Position:
LOAD
    /*==============================
      Keys and Grain Definition
    ==============================*/
    company_code,
    country,
    cost_center,

    /*==============================
      Time Attributes
    ==============================*/
    fiscal_year,
    fiscal_month,
    Date(MakeDate(fiscal_year, fiscal_month, 1), 'YYYY-MM') AS fiscal_year_month,

    /*==============================
      Scenario
    ==============================*/
    pooling_scenario,

    /*==============================
      Currency
    ==============================*/
    currency,

    /*==============================
      Monetary Measures (Local Currency)
    ==============================*/
    opening_balance,
    cash_in,
    cash_out,
    closing_balance

RESIDENT CashPosition_Raw;


/*
Decision:
Do not aggregate or calculate balances at this stage.

Rationale:
- Keeps fact table flexible
- Supports multiple aggregation strategies
- Avoids premature optimization
*/


/*------------------------------------------------------------------------------
  7.2 Fact Table Validation Fields (Optional)
------------------------------------------------------------------------------*/

/*
Decision:
Include explicit record-level flags to support validation and reconciliation.

Rationale:
- Facilitates PoC testing
- Helps explain data quality concepts in portfolio discussions
*/

Fact_Cash_Position_Validated:
LOAD
    *,
    IF(
        opening_balance + cash_in - cash_out = closing_balance,
        1,
        0
    ) AS balance_check_flag
RESIDENT Fact_Cash_Position;

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Validated TO Fact_Cash_Position;


/*------------------------------------------------------------------------------
  7.3 Preparation for Future Enhancements
------------------------------------------------------------------------------*/

/*
Decision:
Keep currency and company keys explicitly in the fact.

Rationale:
- Required for upcoming currency conversion
- Required for hierarchical consolidation
- Avoids rework later in the pipeline

/******************************************************************************************
 *
 * CURRENCY CONVERSION
 *
 * Scope:
 * - Convert monetary values from local currency to group reporting currency
 * - Centralize exchange rate governance in ETL
 *
 ******************************************************************************************/

/*==============================================================================
  8. CURRENCY CONVERSION LOGIC
==============================================================================*/

/*
Decision:
Perform currency conversion during ETL instead of in the dashboard.

Rationale:
- Improves dashboard performance
- Ensures metric consistency
- Centralizes financial logic under governance
*/


/*------------------------------------------------------------------------------
  8.1 Prepare Currency Exchange Lookup
------------------------------------------------------------------------------*/

/*
Decision:
Use a mapping table for currency conversion.

Rationale:
- Simple and performant lookup
- Adequate for PoC scope
- Easily replaceable by time-dependent FX tables later
*/

Currency_Rate_Map:
MAPPING LOAD
    currency,
    exchange_rate_to_group
RESIDENT Dim_Currency;


/*------------------------------------------------------------------------------
  8.2 Apply Currency Conversion to Fact Table
------------------------------------------------------------------------------*/

/*
Decision:
Create converted monetary measures as new fields,
preserving original local currency values.

Rationale:
- Maintains auditability
- Allows dual-currency analysis if needed
*/

Fact_Cash_Position_Converted:
LOAD
    *,

    /*==============================
      Converted Measures (Group Currency)
    ==============================*/
    opening_balance * ApplyMap('Currency_Rate_Map', currency, 1)
        AS opening_balance_grp,

    cash_in * ApplyMap('Currency_Rate_Map', currency, 1)
        AS cash_in_grp,

    cash_out * ApplyMap('Currency_Rate_Map', currency, 1)
        AS cash_out_grp,

    closing_balance * ApplyMap('Currency_Rate_Map', currency, 1)
        AS closing_balance_grp

RESIDENT Fact_Cash_Position;


/*
Decision:
Default exchange rate = 1 when currency is not found.

Rationale:
- Prevents script failure
- Highlights data quality issues without blocking reload
*/


/*------------------------------------------------------------------------------
  8.3 Replace Original Fact Table
------------------------------------------------------------------------------*/

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Converted TO Fact_Cash_Position;

/******************************************************************************************
 *
 * VERSION 6 – CASH POOLING CONSOLIDATION
 *
 * Scope:
 * - Implement cash consolidation logic
 * - Support group-level treasury analysis
 * - Preserve detail and auditability
 *
 ******************************************************************************************/

/*==============================================================================
  9. CONSOLIDATION LOGIC
==============================================================================*/

/*
Decision:
Implement consolidation through dimensional hierarchy,
not by pre-aggregating or collapsing the fact table.

Rationale:
- Preserves analytical flexibility
- Supports both legal entity and group views
- Reflects real treasury operating models
*/


/*------------------------------------------------------------------------------
  9.1 Prepare Company-to-Holding Mapping
------------------------------------------------------------------------------*/

/*
Decision:
Create a mapping table to associate each company with its holding.

Rationale:
- Simplifies consolidation logic
- Avoids complex joins in the fact table
- Keeps hierarchy governance centralized
*/

Company_To_Holding_Map:
MAPPING LOAD
    company_code,
    IF(LEN(TRIM(parent_company)) > 0, parent_company, company_code)
        AS holding_company
RESIDENT Dim_Company;


/*
Decision:
If a company has no parent, it is considered its own holding.

Rationale:
- Simplifies logic
- Avoids NULL handling downstream
*/


/*------------------------------------------------------------------------------
  9.2 Enrich Fact Table with Holding Company
------------------------------------------------------------------------------*/

Fact_Cash_Position_Consolidated:
LOAD
    *,

    ApplyMap(
        'Company_To_Holding_Map',
        company_code,
        company_code
    ) AS holding_company

RESIDENT Fact_Cash_Position;


/*------------------------------------------------------------------------------
  9.3 Replace Original Fact Table
------------------------------------------------------------------------------*/

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Consolidated TO Fact_Cash_Position;


/*
Decision:
Do not aggregate consolidated values at ETL level.

Rationale:
- Allows dynamic consolidation in analysis
- Avoids double-counting risks
- Supports flexible reporting scopes
*/
/******************************************************************************************
 *
 * VERSION 7 – EXECUTIVE METRICS & BENCHMARKS
 *
 * Scope:
 * - Create executive-level treasury metrics
 * - Enable Cash Pooling impact analysis
 * - Finalize governed analytical layer
 *
 ******************************************************************************************/

/*==============================================================================
  10. EXECUTIVE METRICS
==============================================================================*/

/*
Decision:
Create executive metrics at ETL level rather than exclusively in dashboards.

Rationale:
- Ensures metric governance
- Prevents inconsistent calculations
- Enables reuse across multiple visualizations
*/


/*------------------------------------------------------------------------------
  10.1 Monthly Average Cash Balance
------------------------------------------------------------------------------*/

/*
Definition:
Average monthly cash balance, used as a proxy for idle cash exposure.

Formula:
(opening_balance_grp + closing_balance_grp) / 2
*/

Fact_Cash_Position_Metrics:
LOAD
    *,

    /*==============================
      Average Monthly Cash Balance
    ==============================*/
    (opening_balance_grp + closing_balance_grp) / 2
        AS avg_monthly_cash_grp

RESIDENT Fact_Cash_Position;

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Metrics TO Fact_Cash_Position;


/*------------------------------------------------------------------------------
  10.2 Cash Variation
------------------------------------------------------------------------------*/

/*
Definition:
Net cash movement during the period.

Formula:
cash_in_grp - cash_out_grp
*/

Fact_Cash_Position_Metrics2:
LOAD
    *,

    (cash_in_grp - cash_out_grp)
        AS net_cash_movement_grp

RESIDENT Fact_Cash_Position;

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Metrics2 TO Fact_Cash_Position;


/*------------------------------------------------------------------------------
  10.3 Cash Pooling Impact Metrics
------------------------------------------------------------------------------*/

/*
Decision:
Model Cash Pooling impact through scenario comparison
instead of storing pre-calculated deltas.

Rationale:
- Keeps fact table normalized
- Allows flexible comparison logic
*/

Fact_Cash_Position_Metrics3:
LOAD
    *,

    IF(
        pooling_scenario = 'POST_POOLING',
        avg_monthly_cash_grp,
        0
    ) AS avg_cash_post_pooling,

    IF(
        pooling_scenario = 'PRE_POOLING',
        avg_monthly_cash_grp,
        0
    ) AS avg_cash_pre_pooling

RESIDENT Fact_Cash_Position;

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Metrics3 TO Fact_Cash_Position;


/*------------------------------------------------------------------------------
  10.4 Benchmark Support Fields
------------------------------------------------------------------------------*/

/*
Benchmarks Enabled:
- Reduction of average idle cash
- Percentage improvement after Cash Pooling

These fields allow simple, transparent aggregation in dashboards.
*/

Fact_Cash_Position_Final:
LOAD
    *,

    (avg_cash_pre_pooling - avg_cash_post_pooling)
        AS cash_reduction_grp,

    IF(
        avg_cash_pre_pooling <> 0,
        (avg_cash_pre_pooling - avg_cash_post_pooling) / avg_cash_pre_pooling,
        NULL()
    ) AS cash_reduction_pct

RESIDENT Fact_Cash_Position;

DROP TABLE Fact_Cash_Position;
RENAME TABLE Fact_Cash_Position_Final TO Fact_Cash_Position;


/*
Decision:
Do not hardcode benchmark targets (e.g. 15% reduction) in ETL.

Rationale:
- Benchmarks vary by company and context
- Targets should be adjustable in analysis layer
*/
